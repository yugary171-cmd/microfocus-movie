page {
  min-height: 100%;
  color: #17171b;
  background: #fff;
}

.search-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(20rpx + env(safe-area-inset-top)) 30rpx calc(44rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.topbar {
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.back-button,
.submit-button,
.chip,
.hot-item {
  margin: 0;
}

.back-button {
  width: 54rpx;
  min-width: 54rpx;
  height: 70rpx;
  padding: 0;
  color: #1f2024;
  background: transparent;
  font-size: 54rpx;
  font-weight: 300;
  line-height: 62rpx;
}

.search-box {
  display: flex;
  flex: 1;
  gap: 14rpx;
  align-items: center;
  height: 72rpx;
  min-width: 0;
  padding: 0 22rpx;
  background: #f4f4f6;
  border-radius: 18rpx;
}

.magnifier {
  position: relative;
  width: 20rpx;
  height: 20rpx;
  flex: none;
  border: 3rpx solid #8e9098;
  border-radius: 50%;
}

.magnifier::after {
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  width: 9rpx;
  height: 3rpx;
  background: #8e9098;
  border-radius: 99rpx;
  content: "";
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  color: #1f2024;
  font-size: 26rpx;
}

.search-placeholder {
  color: #a6a7ac;
}

.submit-button {
  padding: 0;
  color: #4b56e9;
  background: transparent;
  font-size: 27rpx;
  font-weight: 650;
}

.section {
  margin-top: 52rpx;
}

.section-title {
  color: #1c1d21;
  font-size: 32rpx;
  font-weight: 700;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 24rpx;
}

.chip {
  min-width: 132rpx;
  padding: 14rpx 24rpx;
  color: #50515a;
  background: #f5f5f7;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.35;
}

.suggestions-section {
  margin-top: 56rpx;
}

.suggestion-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 30rpx;
  margin-top: 26rpx;
}

.suggestion {
  color: #64656d;
  font-size: 26rpx;
  line-height: 1.4;
}

.hot-section {
  margin-top: 62rpx;
}

.hot-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.hot-subtitle {
  color: #a0a1a8;
  font-size: 23rpx;
}

.hot-list {
  margin-top: 20rpx;
}

.hot-item {
  display: flex;
  width: 100%;
  gap: 18rpx;
  align-items: center;
  min-height: 82rpx;
  padding: 0;
  color: #1f2024;
  background: transparent;
  text-align: left;
}

.rank {
  width: 28rpx;
  color: #9b9ca3;
  font-size: 25rpx;
  font-style: italic;
  font-weight: 700;
  text-align: center;
}

.rank-1,
.rank-2,
.rank-3 {
  color: #f25b55;
}

.rank-2 {
  color: #f4854c;
}

.rank-3 {
  color: #e4ad47;
}

.hot-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #28292e;
  font-size: 27rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hot-tag {
  padding: 2rpx 7rpx;
  color: #f05252;
  background: #fff0ef;
  border-radius: 5rpx;
  font-size: 18rpx;
  line-height: 1.25;
}

.heat {
  min-width: 68rpx;
  color: #b4b5bb;
  font-size: 21rpx;
  text-align: right;
}

.empty-state {
  margin-top: 26rpx;
  padding: 44rpx 20rpx;
  color: #a0a1a8;
  background: #fafafb;
  border-radius: 16rpx;
  font-size: 25rpx;
  text-align: center;
}
