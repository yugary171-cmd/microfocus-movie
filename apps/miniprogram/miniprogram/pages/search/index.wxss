page {
  min-height: 100%;
  color: #17171b;
  background: #fff;
}

.search-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-right: 30rpx;
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
  padding-left: 30rpx;
  background: #fff;
}

.topbar {
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.back-button,
.submit-button,
.suggestion,
.refresh,
.clear,
.result-item {
  margin: 0;
}

.back-button {
  width: 54rpx;
  min-width: 54rpx;
  height: 70rpx;
  padding: 0;
  color: #1f2024;
  background: transparent;
  font-size: 54rpx;
  font-weight: 300;
  line-height: 62rpx;
}

.search-box {
  display: flex;
  flex: 1;
  gap: 14rpx;
  align-items: center;
  height: 72rpx;
  min-width: 0;
  padding: 0 22rpx;
  background: #f4f4f6;
  border-radius: 18rpx;
}

.magnifier {
  position: relative;
  width: 20rpx;
  height: 20rpx;
  flex: none;
  border: 3rpx solid #8e9098;
  border-radius: 50%;
}

.magnifier::after {
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  width: 9rpx;
  height: 3rpx;
  background: #8e9098;
  border-radius: 99rpx;
  content: "";
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  color: #1f2024;
  font-size: 26rpx;
}

.search-placeholder {
  color: #a6a7ac;
}

.clear-input {
  margin: 0;
  width: 34rpx;
  height: 34rpx;
  flex: none;
  padding: 0;
  color: #92939a;
  background: transparent;
  font-size: 40rpx;
  line-height: 28rpx;
  text-align: center;
}

.submit-button {
  padding: 0;
  color: #4b56e9;
  background: transparent;
  font-size: 27rpx;
  font-weight: 650;
}

.section {
  margin-top: 52rpx;
}

.section-title {
  color: #1c1d21;
  font-size: 32rpx;
  font-weight: 700;
}

.suggestions-section {
  margin-top: 56rpx;
}

.guess-heading,
.result-heading,
.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-section {
  margin-top: 28rpx;
}

.history-clear {
  margin: 0;
  padding: 0 8rpx;
  color: #999aa1;
  background: transparent;
  font-size: 24rpx;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.history-item {
  display: flex;
  max-width: 100%;
  gap: 8rpx;
  align-items: center;
  padding: 10rpx 14rpx;
  color: #4b4c54;
  background: #f5f5f7;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.history-text {
  overflow: hidden;
  max-width: 260rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-remove {
  color: #a0a1a8;
  font-size: 30rpx;
  line-height: 22rpx;
}

.refresh,
.clear {
  padding: 0 8rpx;
  color: #8b8d96;
  background: transparent;
  font-size: 24rpx;
}

.refresh {
  width: 56rpx;
  height: 56rpx;
  font-size: 32rpx;
  line-height: 52rpx;
}

.suggestion-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 30rpx;
  margin-top: 26rpx;
}

.suggestion {
  display: block;
  width: calc(50% - 15rpx);
  margin: 0;
  padding: 18rpx 0;
  color: #64656d;
  background: transparent;
  font-size: 26rpx;
  line-height: 1.4;
  text-align: left;
}

.results-section {
  margin-top: 30rpx;
}

.result-item {
  display: block;
  width: 100%;
  margin-top: 16rpx;
  padding: 20rpx;
  color: #28292e;
  background: #fafafb;
  border-radius: 16rpx;
  text-align: left;
}

.result-title {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-meta {
  margin-top: 8rpx;
  color: #9b9ca3;
  font-size: 22rpx;
}

.empty-state {
  margin-top: 26rpx;
  padding: 44rpx 20rpx;
  color: #a0a1a8;
  background: #fafafb;
  border-radius: 16rpx;
  font-size: 25rpx;
  text-align: center;
}
