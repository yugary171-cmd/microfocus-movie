<view class="search-page" style="padding-top: {{navInsetTop}}px">
  <view class="topbar">
    <button class="back-button" bindtap="goBack" aria-label="返回">‹</button>
    <view class="search-box">
      <view class="magnifier" />
    <input class="search-input" value="{{query}}" maxlength="{{queryMaxLength}}" bindinput="onQueryInput" bindconfirm="submitSearch" confirm-type="search" placeholder="{{searchPlaceholder}}" placeholder-class="search-placeholder" aria-label="搜索短剧、角色、剧情" />
    <view wx:if="{{query}}" class="clear-input" bindtap="clearSearch" aria-label="清除搜索内容">×</view>
    </view>
    <button class="submit-button" bindtap="submitSearch">搜索</button>
  </view>

  <view wx:if="{{!searched}}" class="section suggestions-section">
    <view wx:if="{{searchHistory.length}}" class="history-section">
      <view class="section-heading">
        <view class="section-title">历史搜索</view>
        <button class="history-clear" bindtap="clearHistory">清空</button>
      </view>
      <view class="history-list">
        <view wx:for="{{searchHistory}}" wx:key="*this" class="history-item" data-query="{{item}}" bindtap="chooseHistory">
          <text class="history-text">{{item}}</text>
          <view class="history-remove" data-query="{{item}}" bindtap="removeHistory" aria-label="删除记录">×</view>
        </view>
      </view>
    </view>
    <view class="guess-heading">
      <view class="section-title">猜你想搜</view>
      <button class="refresh" bindtap="refreshGuesses" aria-label="换一批">↻</button>
    </view>
    <view class="suggestion-row">
      <button wx:for="{{guesses}}" wx:key="*this" class="suggestion" data-query="{{item}}" bindtap="chooseGuess">{{item}}</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="empty-state">正在搜索…</view>
  <view wx:elif="{{error}}" class="empty-state" role="alert">{{error}}</view>
  <view wx:elif="{{searched && !results.length}}" class="empty-state">没有找到“{{query}}”相关短剧</view>
  <view wx:elif="{{results.length}}" class="section results-section">
    <view class="result-heading">
      <view class="section-title">搜索结果</view>
      <button class="clear" bindtap="clearSearch">返回发现</button>
    </view>
    <button wx:for="{{results}}" wx:key="id" class="result-item" data-id="{{item.id}}" bindtap="openDrama">
      <view class="result-title">{{item.title}}</view>
      <view class="result-meta">{{item.category}} · 全 {{item.episodeCount}} 集</view>
    </button>
  </view>
</view>
