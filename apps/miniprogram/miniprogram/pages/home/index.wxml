<view class="home-page">
  <view class="search-row">
    <view class="search-field">
      <text class="search-icon">⌕</text>
      <input value="{{query}}" bindinput="onQueryInput" bindconfirm="openSearch" confirm-type="search" placeholder="搜剧名、演员、剧情" placeholder-class="search-placeholder" aria-label="搜索短剧" />
    </view>
    <button class="recognize" bindtap="showAction" data-label="识别" aria-label="识别图片中的剧">▣ 识别</button>
  </view>

  <scroll-view class="channels" scroll-x enable-flex aria-label="内容频道">
    <view class="channels-inner">
      <button wx:for="{{channels}}" wx:key="*this" class="channel {{activeChannel === item ? 'active' : ''}}" data-channel="{{item}}" bindtap="selectChannel">{{item}}</button>
    </view>
  </scroll-view>

  <view class="quick-actions">
    <button wx:for="{{quickActions}}" wx:key="label" class="quick-action" data-label="{{item.label}}" bindtap="showAction">
      <text class="quick-icon quick-{{item.tone}}">{{item.icon}}</text>
      <text>{{item.label}}</text>
    </button>
  </view>

  <view wx:if="{{isMock}}" class="mock-note">内部体验 · 以下剧目、榜单和热度均为 Mock 数据</view>
  <view class="drama-grid" aria-label="热门短剧">
    <button wx:for="{{dramas}}" wx:key="id" class="drama-card" data-id="{{item.id}}" bindtap="openTheater" aria-label="播放 {{item.title}}">
      <view class="poster poster-{{item.tone}}">
        <view class="hot-badge">爆剧</view>
        <view class="poster-copy">
          <text class="poster-title">{{item.title}}</text>
          <text class="poster-subtitle">{{item.subtitle}}</text>
          <text class="heat">♨ {{item.heat}}</text>
        </view>
      </view>
      <view class="drama-title">{{item.title}}</view>
      <view class="ranking">{{item.ranking}} ›</view>
    </button>
  </view>
</view>
