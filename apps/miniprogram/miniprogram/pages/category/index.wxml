<view class="page">
  <internal-banner visible="{{isMock}}" />
  <view class="page-title">找你想看的</view>
  <view class="search-box">
    <input class="search-input" value="{{query}}" maxlength="{{queryMaxLength}}" bindinput="onQueryInput" bindconfirm="onSearchConfirm" confirm-type="search" placeholder="搜索剧名或标签" placeholder-class="search-placeholder" aria-label="搜索剧名或标签" />
    <button class="search-button" bindtap="onSearchConfirm" loading="{{loading}}" aria-label="提交搜索">搜索</button>
  </view>
  <scroll-view scroll-x enable-flex class="filters" aria-label="短剧分类">
    <button wx:for="{{categories}}" wx:key="*this" class="filter {{category === item ? 'active' : ''}}" data-category="{{item}}" bindtap="selectCategory" aria-pressed="{{category === item}}">{{item}}</button>
  </scroll-view>

  <view wx:if="{{loading}}" class="state-card" role="status">正在搜索…</view>
  <view wx:elif="{{error}}" class="state-card" role="alert">
    <view class="state-title">搜索失败</view>
    <view>{{error}}</view>
    <button class="secondary-button retry" bindtap="onSearchConfirm">重试</button>
  </view>
  <view wx:elif="{{searched && !results.length}}" class="state-card">
    <view class="state-title">没有找到相关短剧</view>
    <view>换个关键词或分类试试。</view>
  </view>
  <view wx:else class="results">
    <drama-card wx:for="{{results}}" wx:key="id" drama="{{item}}" compact="{{true}}" />
    <button wx:if="{{hasMore}}" class="secondary-button load-more" bindtap="loadMore" loading="{{loadingMore}}">加载更多</button>
  </view>
</view>
