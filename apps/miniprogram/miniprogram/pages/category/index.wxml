<view class="filter-page">
  <view class="filter-header" style="padding-top: {{navInsetTop}}px;">
    <view class="back" bindtap="goBack">‹</view>
    <view class="page-title">筛选</view>
  </view>
  <view class="filter-panel">
    <view
      wx:for="{{visibleSections}}"
      wx:key="key"
      class="filter-row"
    >
      <button class="filter-all {{selectedFilters[item.key] === item.all ? 'active' : ''}}" data-key="{{item.key}}" data-value="{{item.all}}" bindtap="selectFilter">{{item.all}}</button>
      <scroll-view class="filter-options-row" scroll-x show-scrollbar="{{false}}">
        <view class="filter-row-inner">
          <button
            wx:for="{{item.choices}}"
            wx:for-item="option"
            wx:key="*this"
            class="filter-chip {{selectedFilters[item.key] === option ? 'active' : ''}}"
            data-key="{{item.key}}"
            data-value="{{option}}"
            bindtap="selectFilter"
          >{{option}}</button>
        </view>
      </scroll-view>
    </view>
    <button class="collapse-button" bindtap="toggleExpanded">
      <text>{{filtersExpanded ? '收起' : '展开'}}</text>
      <image class="collapse-icon {{filtersExpanded ? 'expanded' : ''}}" src="/assets/icons/weui-arrow-down.svg" mode="aspectFit" aria-hidden="true" />
    </button>
  </view>
  <view wx:if="{{loading}}" class="filter-state">正在加载短剧…</view>
  <view wx:elif="{{error}}" class="filter-state">{{error}}</view>
  <view wx:elif="{{!results.length}}" class="filter-state">没有符合筛选条件的短剧</view>
  <view wx:else class="filter-grid">
    <button wx:for="{{results}}" wx:key="id" class="filter-card" data-id="{{item.id}}" bindtap="openDrama">
      <view class="filter-poster">{{item.title[0]}}</view>
      <view class="filter-title">{{item.title}}</view>
      <view class="filter-meta">热度 {{item.heat}} · {{item.tag}}</view>
    </button>
  </view>
  <view wx:if="{{loadingMore}}" class="filter-state">正在加载更多…</view>
  <view wx:elif="{{hasMore}}" class="filter-state">上滑加载更多</view>
  <view wx:elif="{{results.length >= pageSize}}" class="filter-state">已经到底了</view>
</view>
