page {
  height: 100%;
  overflow: hidden;
  color: #fff;
  background: #08080a;
}

.theater-page,
.theater-swiper,
.slide,
.theater-video,
.video-shade,
.hit-layer {
  width: 100%;
  height: 100%;
}

.theater-page {
  position: relative;
  overflow: hidden;
  background: #08080a;
}

.theater-swiper,
.slide,
.theater-video,
.video-shade,
.hit-layer {
  position: absolute;
  inset: 0;
}

.hit-layer {
  z-index: 2;
}

.pause-mark,
.boost-mark {
  position: absolute;
  z-index: 3;
  top: 50%;
  left: 50%;
  pointer-events: none;
}

.pause-mark {
  width: 96rpx;
  height: 96rpx;
  margin: -48rpx 0 0 -48rpx;
  color: #fff;
  background: rgba(8, 8, 10, 0.45);
  border-radius: 50%;
  padding: 22rpx;
  box-sizing: border-box;
}

.boost-mark {
  min-width: 120rpx;
  height: 64rpx;
  margin: -32rpx 0 0 -60rpx;
  color: #17130a;
  background: rgba(255, 207, 90, 0.92);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 64rpx;
  text-align: center;
}

.refresh-panel {
  position: absolute;
  z-index: 3;
  top: calc(-96rpx + env(safe-area-inset-top));
  left: 0;
  display: flex;
  gap: 12rpx;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 78rpx;
  color: rgba(255, 255, 255, 0.94);
  font-size: 25rpx;
  opacity: 0;
  transition: opacity .16s ease, transform .16s ease;
}

.refresh-panel.visible { opacity: 1; }
.refresh-spinner { color: #fff; font-size: 38rpx; line-height: 1; }
.refresh-spinner.spinning { animation: refresh-spin .75s linear infinite; }

@keyframes refresh-spin { to { transform: rotate(360deg); } }

.theater-video {
  z-index: 0;
}

.video-shade {
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.56) 0%, rgba(0, 0, 0, 0.04) 33%, rgba(0, 0, 0, 0.04) 55%, rgba(0, 0, 0, 0.8) 100%);
}

.topbar {
  position: relative;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(20rpx + env(safe-area-inset-top)) 28rpx 0;
}

.video-marker,
.swipe-tip {
  position: absolute;
  z-index: 4;
  left: 28rpx;
  color: rgba(255, 255, 255, .68);
  font-size: 20rpx;
}

.video-marker { top: calc(104rpx + env(safe-area-inset-top)); }
.swipe-tip { top: calc(134rpx + env(safe-area-inset-top)); color: rgba(255,255,255,.48); }

.categories {
  display: flex;
  gap: 32rpx;
  align-items: center;
}

.category,
.search-button,
.action {
  margin: 0;
  padding: 0;
  color: inherit;
  background: transparent;
}

.category {
  min-width: auto;
  color: rgba(255, 255, 255, 0.68);
  font-size: 27rpx;
  line-height: 58rpx;
}

.category.active {
  position: relative;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}

.category.active::after {
  position: absolute;
  right: 12rpx;
  bottom: -2rpx;
  left: 12rpx;
  height: 5rpx;
  background: #fff;
  border-radius: 99rpx;
  content: "";
}

.search-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
}

.content {
  position: absolute;
  z-index: 4;
  right: 26rpx;
  bottom: calc(38rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  display: flex;
  gap: 22rpx;
  align-items: flex-end;
}

.full-drama {
  margin-top: 22rpx;
  padding: 16rpx 18rpx;
  color: rgba(255,255,255,.95);
  background: rgba(9, 9, 12, .38);
  border-radius: 12rpx;
  font-size: 23rpx;
}

.full-drama > image:first-child { width: 30rpx; height: 30rpx; margin-right: 8rpx; vertical-align: middle; }.full-drama > image:last-child { float: right; width: 22rpx; height: 30rpx; }

.story {
  flex: 1;
  min-width: 0;
}

.episode-label {
  margin-bottom: 12rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 24rpx;
}

.drama-title {
  overflow: hidden;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.description {
  display: -webkit-box;
  margin-top: 14rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.82);
  font-size: 25rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  flex: none;
  padding-bottom: 2rpx;
}

.action {
  width: 72rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 19rpx;
  line-height: 1.3;
}

.action-icon {
  display: block;
  width: 47rpx;
  height: 47rpx;
}

.action-icon.selected {
  color: #ff5e72;
}
