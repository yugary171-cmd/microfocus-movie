<view class="theater-page">
  <video id="theater-video" class="theater-video" src="{{currentVideo.url}}" autoplay loop muted controls="{{false}}" show-center-play-btn="{{false}}" object-fit="cover" bindloadedmetadata="onVideoReady" aria-label="{{currentVideo.dramaTitle}}沉浸式短剧播放器" />
  <view class="video-shade" />
  <view class="gesture-layer" catchtouchstart="onGestureStart" catchtouchmove="onGestureMove" catchtouchend="onGestureEnd" />

  <view class="refresh-panel {{isPulling || refreshing ? 'visible' : ''}}" style="transform: translateY({{pullDistance}}px)">
    <view class="refresh-spinner {{refreshing ? 'spinning' : ''}}">↻</view>
    <view>{{refreshLabel}}</view>
  </view>

  <view class="topbar">
    <view class="categories" role="tablist" aria-label="短剧分类">
      <button wx:for="{{categories}}" wx:key="*this" class="category {{activeCategory === item ? 'active' : ''}}" data-category="{{item}}" bindtap="selectCategory" role="tab" aria-selected="{{activeCategory === item}}">{{item}}</button>
    </view>
    <button class="search-button" bindtap="openSearch" aria-label="搜索短剧"><view class="search-icon" /></button>
  </view>

  <view class="video-marker">Mock 视频 {{currentIndex + 1}} / {{videos.length}}</view>
  <view class="swipe-tip">上滑切换下一条 · 首条下拉刷新</view>

  <view class="content">
    <view class="story">
      <view class="episode-label">{{currentVideo.episodeLabel}}</view>
      <view class="drama-title">{{currentVideo.dramaTitle}}</view>
      <view class="description">{{currentVideo.description}}</view>
      <view class="full-drama">▣ 观看完整短剧 · 全集更新中 <text>›</text></view>
    </view>
    <view class="actions" aria-label="短剧互动">
      <button class="action" data-action="favorite" bindtap="handleAction" aria-label="收藏"><view class="action-icon {{isFavorite ? 'selected' : ''}}">☆</view><view>{{currentVideo.favoriteCount}}</view></button>
      <button class="action" data-action="comment" bindtap="handleAction" aria-label="评论"><view class="action-icon">◯</view><view>{{currentVideo.commentCount}}</view></button>
      <button class="action" data-action="like" bindtap="handleAction" aria-label="点赞"><view class="action-icon {{isLiked ? 'selected' : ''}}">♡</view><view>{{currentVideo.likeCount}}</view></button>
      <button class="action" data-action="share" bindtap="handleAction" aria-label="分享"><view class="action-icon">↗</view><view>{{currentVideo.shareCount}}</view></button>
    </view>
  </view>
</view>
