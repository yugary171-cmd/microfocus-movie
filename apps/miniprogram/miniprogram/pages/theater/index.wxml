<view class="theater-page">
  <swiper class="theater-swiper" vertical circular="{{false}}" current="{{currentIndex}}" duration="280" bindchange="onSwiperChange" bindanimationfinish="onSwiperFinish" aria-label="{{currentVideo.dramaTitle}}沉浸式短剧播放器">
    <swiper-item wx:for="{{videos}}" wx:key="id" wx:for-index="index">
      <view class="slide">
        <video wx:if="{{index >= currentIndex - 1 && index <= currentIndex + 1}}" id="theater-video-{{index}}" class="theater-video" src="{{item.url}}" autoplay="{{index === currentIndex}}" muted="{{false}}" obey-mute-switch="{{false}}" controls="{{false}}" show-center-play-btn="{{false}}" object-fit="cover" bindplay="onPlay" bindpause="onPause" bindloadedmetadata="onSlideReady" bindtimeupdate="onTimeUpdate" bindended="onEnded" aria-label="{{item.dramaTitle}}" />
        <view class="video-shade" />
        <view class="hit-layer" bindtap="togglePlayback" bindlongpress="startHoldBoost" bindtouchstart="onFirstTouchStart" bindtouchmove="onFirstTouchMove" bindtouchend="onSlideTouchEnd" bindtouchcancel="endHoldBoost" />
      </view>
    </swiper-item>
  </swiper>
  <view wx:if="{{!isPlaying}}" class="play-mark" aria-label="播放当前视频" />
  <view wx:elif="{{holdBoosting}}" class="boost-mark" aria-live="polite">{{boostRateLabel}}</view>

  <view class="theater-progress" catchtouchstart="stopProgressGesture" catchtouchmove="stopProgressGesture" catchtouchend="stopProgressGesture">
    <slider value="{{currentTime}}" min="0" max="{{duration || 1}}" disabled="{{!duration}}" activeColor="#ff7a18" backgroundColor="rgba(255, 255, 255, .34)" block-color="#fff" block-size="16" bindchange="onProgressChange" aria-label="视频播放进度" />
  </view>

  <view class="refresh-panel {{isPulling || refreshing ? 'visible' : ''}}" style="transform: translateY({{pullDistance}}px)">
    <view class="refresh-spinner {{refreshing ? 'spinning' : ''}}">↻</view>
    <view>{{refreshLabel}}</view>
  </view>

  <view class="topbar">
    <view class="categories" role="tablist" aria-label="短剧分类">
      <button wx:for="{{categories}}" wx:key="*this" class="category {{activeCategory === item ? 'active' : ''}}" data-category="{{item}}" bindtap="selectCategory" role="tab" aria-selected="{{activeCategory === item}}">{{item}}</button>
    </view>
    <button class="search-button" bindtap="openSearch" aria-label="搜索短剧"><image class="search-icon" src="/assets/icons/weui-search.svg" mode="aspectFit" aria-hidden="true" /></button>
  </view>

  <view class="video-marker">Mock 视频 {{currentIndex + 1}} / {{videos.length}}</view>
  <view class="swipe-tip">轻点暂停 · 长按加速 · 上下滑切换拼接条目</view>

  <view class="content">
    <view class="story">
      <view class="episode-label">{{currentVideo.episodeLabel}}</view>
      <view class="drama-title">{{currentVideo.dramaTitle}}</view>
      <view class="description">{{currentVideo.description}}</view>
      <view class="full-drama"><image src="/assets/icons/icon-play.svg" mode="aspectFit" aria-hidden="true" />观看完整短剧 · 全集更新中 <image src="/assets/icons/weui-arrow-right.svg" mode="aspectFit" aria-hidden="true" /></view>
    </view>
    <view class="actions" aria-label="短剧互动">
      <button class="action" data-action="favorite" bindtap="handleAction" aria-label="收藏"><image class="action-icon" src="/assets/icons/icon-star-active.svg" mode="aspectFit" aria-hidden="true" /><view>{{currentVideo.favoriteCount}}</view></button>
      <button class="action" data-action="comment" bindtap="handleAction" aria-label="评论"><image class="action-icon" src="/assets/icons/icon-comment.svg" mode="aspectFit" aria-hidden="true" /><view>{{currentVideo.commentCount}}</view></button>
      <button class="action" data-action="like" bindtap="handleAction" aria-label="点赞"><image class="action-icon" src="{{isLiked ? '/assets/icons/icon-heart-active.svg' : '/assets/icons/icon-heart.svg'}}" mode="aspectFit" aria-hidden="true" /><view>{{currentVideo.likeCount}}</view></button>
      <button class="action" data-action="share" bindtap="handleAction" aria-label="分享"><image class="action-icon" src="/assets/icons/icon-share.svg" mode="aspectFit" aria-hidden="true" /><view>{{currentVideo.shareCount}}</view></button>
    </view>
  </view>

  <view class="theater-tabbar" role="navigation" aria-label="底部菜单">
    <button class="theater-tab" data-url="/pages/home/index" bindtap="switchTab">首页</button>
    <button class="theater-tab active" aria-current="page">剧场</button>
    <button class="theater-tab" data-url="/pages/my/index" bindtap="switchTab">我的</button>
  </view>
</view>
