page { background: #effcf9; }
.ranking-page { min-height: 100vh; color: #17171b; background: #effcf9; }
.ranking-hero { padding: 80rpx 36rpx 34rpx; background: linear-gradient(135deg, #52dcb0, #c3f5cf); }
.hero-title { margin-top: 24rpx; font-size: 44rpx; font-weight: 850; }.hero-subtitle { margin-top: 12rpx; color: #458b78; font-size: 22rpx; }
.ranking-panel { padding: 28rpx 36rpx; background: #fff; border-radius: 32rpx 32rpx 0 0; }.ranking-tabs, .ranking-types { white-space: nowrap; }.ranking-tabs { margin-bottom: 22rpx; }.ranking-tools { display: flex; align-items: center; gap: 14rpx; }.ranking-types { flex: 1; min-width: 0; }.ranking-tab, .ranking-type, .ranking-filter, .drawer-option { flex: none; margin: 0 20rpx 0 0; border: 0; }.ranking-tab { padding: 0; color: #999; background: transparent; font-size: 32rpx; }.ranking-tab.active { color: #151519; font-weight: 800; }.ranking-type { padding: 16rpx 28rpx; color: #555; background: #f6f6f7; border-radius: 14rpx; font-size: 25rpx; }.ranking-type.active, .drawer-option.active { color: #e7832b; background: #fff0df; }.ranking-filter { padding: 16rpx 0; color: #222; background: transparent; font-size: 25rpx; }.ranking-state { padding: 80rpx 0; color: #999; text-align: center; }.drawer-mask { position: fixed; z-index: 30; inset: 0; background: rgba(0,0,0,.42); }.drawer { position: absolute; right: 0; bottom: 0; left: 0; padding: 36rpx; background: #fff; border-radius: 28rpx 28rpx 0 0; }.drawer-title { margin-bottom: 24rpx; font-size: 32rpx; font-weight: 800; }.drawer-option { display: inline-block; padding: 18rpx 28rpx; color: #555; background: #f5f5f6; border-radius: 14rpx; font-size: 25rpx; }
