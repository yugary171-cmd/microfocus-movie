page {
  background: #cfe98a;
  color: #17171b;
}

.ranking-page {
  min-height: 100vh;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #c8e86a 0, #d7ef96 280rpx, #f7f7f8 520rpx);
}

.ranking-hero {
  position: relative;
  overflow: hidden;
  padding-right: 36rpx;
  padding-bottom: 28rpx;
  padding-left: 36rpx;
}

.hero-deco {
  position: absolute;
  top: 24rpx;
  right: -40rpx;
  width: 280rpx;
  height: 220rpx;
  border: 10rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 48rpx 18rpx 64rpx 28rpx;
  transform: rotate(-18deg);
  pointer-events: none;
}

.hero-deco::after {
  content: "";
  position: absolute;
  right: 36rpx;
  bottom: -28rpx;
  width: 120rpx;
  height: 120rpx;
  border: 8rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 50%;
}

.hero-bar {
  display: flex;
  align-items: center;
  min-height: 64rpx;
}

.back {
  padding-right: 16rpx;
  font-size: 60rpx;
  line-height: 1;
}

.hero-title {
  position: relative;
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 850;
}

.hero-subtitle {
  position: relative;
  margin-top: 12rpx;
  color: #6f7468;
  font-size: 22rpx;
}

.ranking-body {
  min-height: 70vh;
  padding-bottom: 12rpx;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
}

.ranking-tabs,
.ranking-types,
.rank-drawer-scroller {
  width: 100%;
  white-space: nowrap;
}

.ranking-tabs::-webkit-scrollbar,
.ranking-types::-webkit-scrollbar,
.rank-drawer-scroller::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

.ranking-tabs {
  padding: 24rpx 0 8rpx 36rpx;
}

.ranking-tabs-inner,
.ranking-types-inner {
  display: inline-block;
  white-space: nowrap;
}

.ranking-tab,
.ranking-type,
.ranking-filter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  vertical-align: middle;
  box-sizing: border-box;
}

.ranking-tab {
  margin-right: 36rpx;
  padding: 0;
  color: #9b9ba0;
  background: transparent;
  font-size: 30rpx;
  line-height: 48rpx;
}

.ranking-tab.active {
  color: #151519;
  font-weight: 800;
}

.ranking-tools {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 2;
  padding: 8rpx 8rpx 0 36rpx;
}

.ranking-types-wrap {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.ranking-types {
  width: 100%;
  height: 72rpx;
}

.ranking-type {
  margin-right: 12rpx;
  padding: 0 26rpx;
  height: 56rpx;
  color: #555;
  background: #f6f6f7;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 56rpx;
}

.ranking-type.active {
  color: #e7832b;
  background: #fff0df;
  font-weight: 750;
}

.ranking-filter {
  position: relative;
  z-index: 3;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: auto;
  min-width: 96rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 16rpx;
  color: #222;
  background: transparent;
  font-size: 24rpx;
  line-height: 1;
}

.ranking-filter::after {
  border: none;
}

.chevron-down {
  width: 12rpx;
  height: 12rpx;
  margin-top: -6rpx;
  margin-left: 8rpx;
  border: 0;
  transform: none;
}

.ranking-list {
  padding: 12rpx 36rpx 0;
}

.ranking-item {
  display: flex;
  align-items: flex-start;
  width: 100%;
  margin: 0 0 32rpx;
  padding: 0;
  text-align: left;
  background: transparent;
}

.rank-poster {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  flex-shrink: 0;
  width: 168rpx;
  height: 224rpx;
  color: #fff;
  background: linear-gradient(145deg, #5b8db8, #a54f5a);
  border-radius: 16rpx;
  font-size: 52rpx;
  font-weight: 850;
}

.rank-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  min-width: 36rpx;
  padding: 2rpx 8rpx;
  color: #fff;
  background: #9aa0a8;
  border-radius: 8rpx;
  font-size: 20rpx;
  text-align: center;
}

.rank-badge.rank-0 { background: #f08a2e; }
.rank-badge.rank-1 { background: #2bb3b0; }
.rank-badge.rank-2 { background: #4a86d8; }

.rank-copy {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.rank-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.rank-title,
.rank-meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 750;
}

.rank-hot {
  flex: none;
  color: #ed832a;
  font-size: 22rpx;
}

.rank-meta {
  margin-top: 12rpx;
  color: #999;
  font-size: 23rpx;
}

.rank-summary {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  color: #999;
  font-size: 23rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.ranking-state {
  padding: 40rpx 0;
  color: #999;
  text-align: center;
}

.drawer-mask {
  position: fixed;
  z-index: 30;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
}

.filter-drawer {
  position: absolute;
  top: 20%;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
}

.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 32rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.drawer-close,
.drawer-spacer {
  width: 60rpx;
  text-align: center;
}
.drawer-close { display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; background: transparent; }
.drawer-close image { width: 30rpx; height: 30rpx; }

.drawer-content {
  flex: 1;
  height: 0;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.drawer-content::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

.drawer-section {
  margin: 22rpx 0 32rpx;
}

.drawer-title {
  display: block;
  margin-bottom: 18rpx;
  font-size: 29rpx;
  font-weight: 750;
}

.drawer-options {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.drawer-option {
  margin: 0;
  padding: 18rpx 8rpx;
  color: #4f4f55;
  background: #f5f5f6;
  border-radius: 14rpx;
  font-size: 24rpx;
  text-align: center;
}

.drawer-option.selected {
  color: #f07b29;
  background: #fff0df;
}

.drawer-footer {
  display: flex;
  gap: 24rpx;
  padding: 22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.drawer-clear,
.drawer-confirm {
  flex: 1;
  margin: 0;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  text-align: center;
}

.drawer-clear {
  color: #888;
  background: #f5f5f5;
}

.drawer-confirm {
  color: #fff;
  background: #ff7a2f;
}
