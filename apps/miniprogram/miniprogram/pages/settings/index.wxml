<view class="settings-page">
  <view class="settings-group">
    <button class="settings-item" bindtap="openProfile"><text class="settings-item-label">编辑资料</text><image src="/assets/icons/weui-arrow-right.svg" mode="aspectFit" aria-hidden="true" /></button>
    <button class="settings-item" bindtap="showFeedback"><text class="settings-item-label">用户反馈</text><image src="/assets/icons/weui-arrow-right.svg" mode="aspectFit" aria-hidden="true" /></button>
    <button class="settings-item danger" bindtap="logout"><text>退出登录</text></button>
  </view>
</view>
