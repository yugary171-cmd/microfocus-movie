.profile {
  display: flex;
  gap: 24rpx;
  align-items: center;
  padding: 24rpx 0 8rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  color: #17130a;
  background: #ffcf5a;
  border-radius: 50%;
  font-size: 38rpx;
  font-weight: 800;
}

.profile-title {
  margin: 0 0 6rpx;
}

.history-card,
.menu {
  margin-bottom: 20rpx;
  overflow: hidden;
  background: #17181e;
  border-radius: 20rpx;
}

.history-card {
  padding: 20rpx;
}

.history-main {
  display: flex;
  gap: 20rpx;
}

.history-cover {
  flex: none;
  width: 120rpx;
  height: 160rpx;
  background: #292b34;
  border-radius: 12rpx;
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffcf5a;
  font-size: 44rpx;
  font-weight: 800;
}

.history-copy {
  min-width: 0;
  padding-top: 10rpx;
}

.history-title {
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.updated {
  margin-top: 12rpx;
  color: #797c85;
  font-size: 22rpx;
}

.resume {
  margin: 18rpx 0 0;
  color: #17130a;
  background: #ffcf5a;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  padding: 30rpx 26rpx;
  border-bottom: 2rpx solid #25272f;
  font-size: 28rpx;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-item text {
  color: #777a84;
}

.retry {
  margin-top: 20rpx;
}
