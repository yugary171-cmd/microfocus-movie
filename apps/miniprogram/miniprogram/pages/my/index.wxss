page { background: #f7f7f8; color: #16161a; }
.my-page { position: relative; min-height: 100vh; padding: calc(20rpx + env(safe-area-inset-top)) 0 44rpx; overflow: visible; box-sizing: border-box; background: linear-gradient(180deg, #fcfefd 0, #f8f6f7 330rpx, #f7f7f8 100%); }.ambient { position: absolute; top: 22rpx; right: -100rpx; width: 360rpx; height: 235rpx; background: radial-gradient(circle at 35% 55%, rgba(253, 210, 171, .56), transparent 36%), radial-gradient(circle at 74% 30%, rgba(95, 224, 239, .36), transparent 34%); filter: blur(10rpx); pointer-events: none; }.top-actions { position: relative; z-index: 1; display: flex; justify-content: flex-end; gap: 26rpx; padding: 0 32rpx; }.top-actions button { position: relative; margin: 0; padding: 0; color: #1c1c20; background: transparent; font-size: 48rpx; line-height: 54rpx; }.new-dot { position: absolute; top: 4rpx; right: -6rpx; width: 14rpx; height: 14rpx; background: #ff6c2f; border-radius: 50%; }
.guest-profile { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding: 78rpx 34rpx 70rpx; }.guest-title { font-size: 42rpx; font-weight: 850; }.guest-subtitle { margin-top: 12rpx; color: #929297; font-size: 26rpx; }.login-button { min-width: 180rpx; margin: 0; color: #fff; background: linear-gradient(100deg, #ff9937, #ff6b25); border-radius: 18rpx; box-shadow: 0 9rpx 20rpx rgba(255, 106, 39, .22); font-size: 29rpx; font-weight: 750; }
.member-profile { position: relative; z-index: 1; display: flex; gap: 22rpx; align-items: center; padding: 58rpx 34rpx 38rpx; }.avatar { display: flex; align-items: center; justify-content: center; overflow: hidden; width: 112rpx; height: 112rpx; margin: 0; padding: 0; color: #a74260; background: linear-gradient(145deg, #ffe8ee, #f6a8bc); border: 5rpx solid rgba(255,255,255,.75); border-radius: 50%; box-shadow: 0 7rpx 18rpx rgba(197, 110, 140, .2); font-size: 43rpx; font-weight: 800; line-height: 112rpx; }.avatar::after { border: none; }.avatar-photo { width: 100%; height: 100%; }.member-copy { flex: 1; min-width: 0; }.member-name { overflow: hidden; font-size: 37rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }.member-id { margin-top: 12rpx; color: #9b9ba1; font-size: 23rpx; }.edit-button { margin: 0; padding: 13rpx 20rpx; color: #37363a; background: rgba(255,255,255,.7); border-radius: 12rpx; font-size: 23rpx; }.login-error { position: relative; z-index: 1; margin: -38rpx 34rpx 30rpx; padding: 16rpx 20rpx; color: #c64a38; background: #fff1ee; border-radius: 12rpx; font-size: 22rpx; }
.stats { display: flex; gap: 58rpx; padding: 0 34rpx 18rpx; }.stats view { display: flex; flex-direction: column; gap: 6rpx; }.stats strong { font-size: 36rpx; }.stats text { color: #99999f; font-size: 22rpx; }
.history-panel { padding: 30rpx 34rpx 12rpx; background: #fff; border-radius: 28rpx 28rpx 0 0; }.history-tabs { display: flex; align-items: center; gap: 22rpx; }.history-tab { width: auto; min-width: 0; margin: 0; padding: 0; color: #9b9ba0; background: transparent; font-size: 28rpx; line-height: 64rpx; }.history-tab.active { color: #17171b; font-size: 36rpx; font-weight: 850; }.history-search { margin: 0 0 0 auto; padding: 0; color: #85858a; background: transparent; font-size: 47rpx; line-height: 54rpx; }.history-tools { position: relative; z-index: 2; display: flex; justify-content: space-between; gap: 18rpx; align-items: center; margin-top: 20rpx; }.filters { display: flex; gap: 12rpx; }.filter { width: auto; min-width: 100rpx; margin: 0; padding: 14rpx 16rpx; color: #a3a3a9; background: #f6f5f6; border-radius: 13rpx; font-size: 23rpx; }.filter.active { color: #f28735; background: #fff1df; font-weight: 750; }.tool-actions { display: flex; flex-shrink: 0; align-items: center; gap: 20rpx; }.filter-trigger, .edit-trigger { padding: 8rpx 4rpx; color: #27272b; font-size: 25rpx; line-height: 1.2; }.filter-trigger.active { color: #f28735; font-weight: 750; }.mock-label { margin: 22rpx 0 12rpx; color: #b08059; font-size: 19rpx; }
.history-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28rpx 16rpx; }.history-item { min-width: 0; margin: 0; padding: 0; color: #1e1e23; text-align: left; background: transparent; }.history-poster { position: relative; display: flex; align-items: flex-end; height: 236rpx; padding: 16rpx; overflow: hidden; color: #fff; border-radius: 16rpx; box-sizing: border-box; box-shadow: inset 0 -70rpx 60rpx rgba(0,0,0,.18); }.history-poster::after { position: absolute; top: -40rpx; right: -36rpx; width: 150rpx; height: 150rpx; border: 18rpx solid rgba(255,255,255,.17); border-radius: 50%; content: ""; }.poster-rose { background: linear-gradient(155deg, #2b1f27, #c66d7c 54%, #4d1c32); }.poster-blue { background: linear-gradient(155deg, #2a354e, #8a9dc8 53%, #e4a580); }.poster-ink { background: linear-gradient(155deg, #d9dad5, #7a7b89 55%, #292831); }.poster-gold { background: linear-gradient(155deg, #2c2422, #bd8950 52%, #f4d492); }.poster-wine { background: linear-gradient(155deg, #5f2424, #cf8258 54%, #331d2a); }.poster-night { background: linear-gradient(155deg, #151d29, #42384d 55%, #b85a50); }.poster-tag { position: absolute; top: 10rpx; right: 10rpx; z-index: 1; padding: 5rpx 8rpx; background: rgba(15,15,17,.48); border-radius: 8rpx; font-size: 17rpx; }.poster-title { position: relative; z-index: 1; font-size: 27rpx; font-weight: 850; line-height: 1.15; }.drama-name { overflow: hidden; margin-top: 12rpx; font-size: 25rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.episode { margin-top: 6rpx; color: #9b9ba0; font-size: 20rpx; }
.history-state { padding: 50rpx 20rpx; color: #99999f; font-size: 25rpx; text-align: center; }
.inbox-list { margin-top: 4rpx; }
.inbox-row { display: flex; align-items: center; gap: 22rpx; padding: 28rpx 0; border-bottom: 1rpx solid #f2f2f4; }
.inbox-row:last-child { border-bottom: none; }
.inbox-icon { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; color: #fff; border-radius: 50%; font-size: 28rpx; font-weight: 750; }
.inbox-icon.system { background: #f08a3a; }
.inbox-icon.fans { background: #3db8b0; }
.inbox-icon.comments { background: #4caf7a; }
.inbox-icon.mine { background: #4a90e2; }
.inbox-icon.likes { background: #ff8a3d; }
.inbox-copy { flex: 1; min-width: 0; }
.inbox-title { font-size: 30rpx; font-weight: 750; }
.inbox-preview { overflow: hidden; margin-top: 8rpx; color: #9b9ba0; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.inbox-meta { flex-shrink: 0; color: #b4b4b8; font-size: 22rpx; }
.inbox-chevron { flex-shrink: 0; color: #c8c8cc; font-size: 36rpx; line-height: 1; }
.privacy-actions { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 16rpx; padding: 0 34rpx 28rpx; }
.privacy-link { margin: 0; padding: 12rpx 18rpx; color: #5b5b61; background: rgba(255,255,255,.72); border-radius: 12rpx; font-size: 22rpx; }
.filter-root { position: fixed; z-index: 1000; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; }
.filter-mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.46); }
.filter-panel { position: absolute; right: 0; bottom: 0; left: 0; padding: 8rpx 34rpx calc(28rpx + env(safe-area-inset-bottom)); background: #fff; border-radius: 28rpx 28rpx 0 0; }
.filter-header { display: flex; align-items: center; min-height: 88rpx; }
.filter-close, .filter-clear { margin: 0; padding: 0; color: #2b2b30; background: transparent; }
.filter-close { width: 72rpx; font-size: 36rpx; line-height: 1; }
.filter-title { flex: 1; text-align: center; font-size: 32rpx; font-weight: 800; }
.filter-header-spacer { width: 72rpx; }
.filter-section { margin-top: 18rpx; }
.filter-section-title { margin-bottom: 18rpx; font-size: 28rpx; font-weight: 750; }
.filter-chips { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16rpx; }
.filter-chip { margin: 0; padding: 18rpx 8rpx; color: #5d5d63; background: #f3f3f5; border-radius: 12rpx; font-size: 24rpx; }
.filter-chip::after, .filter-close::after, .filter-clear::after, .filter-confirm::after { border: none; }
.filter-chip.active { color: #f28735; background: #fff1df; font-weight: 750; }
.filter-footer { display: flex; align-items: center; gap: 24rpx; margin-top: 36rpx; }
.filter-clear { font-size: 28rpx; }
.filter-confirm { flex: 1; margin: 0; padding: 22rpx 0; color: #fff; background: #ff7a2f; border-radius: 16rpx; font-size: 30rpx; font-weight: 750; }
