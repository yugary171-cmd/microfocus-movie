<view class="my-page">
  <view class="ambient" />
  <view class="top-actions"><button bindtap="showFeature" data-label="夜间模式" aria-label="夜间模式">☾</button><button bindtap="showFeature" data-label="更多设置" aria-label="更多设置">☰<text class="new-dot" /></button></view>

  <view wx:if="{{!user}}" class="guest-profile">
    <view class="guest-copy"><view class="guest-title">免费短剧，尽在微焦</view><view class="guest-subtitle">登录后同步观看记录与福利权益</view></view>
    <button class="login-button" bindtap="login" loading="{{loginLoading}}" disabled="{{loginLoading}}">{{loginLoading ? '微信登录中…' : '立即登录'}}</button>
  </view>
  <view wx:else class="member-profile">
    <view class="avatar">{{user.initial}}</view>
    <view class="member-copy"><view class="member-name">{{user.displayName}}</view><view class="member-id">{{user.microfocusId}} ⧉</view></view>
    <button class="edit-button" bindtap="showFeature" data-label="编辑资料">编辑资料</button>
  </view>
  <view wx:if="{{loginError}}" class="login-error" role="alert">{{loginError}}</view>
  <view wx:if="{{deletionNotice}}" class="login-error" role="status">{{deletionNotice}}</view>
  <view class="privacy-actions">
    <button class="privacy-link" data-section="privacy" bindtap="openLegal">隐私政策</button>
    <button class="privacy-link" data-section="deletion" bindtap="openLegal">注销说明</button>
    <button wx:if="{{user}}" class="privacy-link" bindtap="requestDeletion" disabled="{{deletionBusy}}">{{deletionBusy ? '提交中…' : '申请注销'}}</button>
    <button class="privacy-link" bindtap="lookupDeletion">查询注销进度</button>
  </view>

  <view wx:if="{{user}}" class="stats"><view><strong>0</strong><text>关注</text></view><view><strong>0</strong><text>粉丝</text></view><view><strong>0</strong><text>获赞</text></view></view>

  <scroll-view scroll-x enable-flex class="utility-scroll" aria-label="个人功能">
    <view class="utility-row">
      <button wx:for="{{utilities}}" wx:key="title" class="utility-card" data-label="{{item.title}}" bindtap="showFeature"><view class="utility-icon">{{item.icon}}</view><view class="utility-title">{{item.title}}</view><view class="utility-subtitle">{{item.subtitle}}</view></button>
    </view>
  </scroll-view>

  <view class="history-panel">
    <view class="history-tabs"><button wx:for="{{historyTabs}}" wx:key="*this" class="history-tab {{activeHistoryTab === item ? 'active' : ''}}" data-tab="{{item}}" bindtap="selectHistoryTab">{{item}}</button><button class="history-search" bindtap="showFeature" data-label="历史搜索" aria-label="搜索历史">⌕</button></view>
    <view class="history-tools"><view class="filters"><button wx:for="{{historyFilters}}" wx:key="*this" class="filter {{activeFilter === item ? 'active' : ''}}" data-filter="{{item}}" bindtap="selectFilter">{{item}}</button></view><view class="tool-actions"><button data-label="筛选" bindtap="showFeature">筛选</button><button data-label="编辑" bindtap="showFeature">编辑</button></view></view>
    <view wx:if="{{isMock}}" class="mock-label">Mock 观看记录</view>
    <view wx:if="{{historyLoading}}" class="history-state">正在读取观看记录…</view>
    <view wx:elif="{{historyError}}" class="history-state" role="alert">{{historyError}}</view>
    <view wx:elif="{{!historyItems.length}}" class="history-state">还没有观看记录</view>
    <view wx:else class="history-grid"><button wx:for="{{historyItems}}" wx:key="id" class="history-item" data-id="{{item.id}}" bindtap="openHistory" aria-label="播放{{item.title}}"><view class="history-poster poster-{{item.tone}}"><text class="poster-tag">{{item.tag}}</text><text class="poster-title">{{item.title}}</text></view><view class="drama-name">{{item.title}}</view><view class="episode">{{item.episode}}</view></button></view>
  </view>
</view>
