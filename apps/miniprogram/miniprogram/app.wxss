page {
  --color-bg: #0b0c0f;
  --color-surface: #17181e;
  --color-surface-soft: #21232b;
  --color-text: #f7f7f8;
  --color-muted: #a1a4ae;
  --color-accent: #ffcf5a;
  --color-danger: #ff6b70;
  --radius-lg: 24rpx;
  --radius-md: 16rpx;
  min-height: 100%;
  color: var(--color-text);
  background: var(--color-bg);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button {
  font: inherit;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

.page-title {
  margin: 16rpx 0 28rpx;
  font-size: 48rpx;
  font-weight: 750;
  line-height: 1.2;
}

.section-title {
  margin: 38rpx 0 20rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.muted {
  color: var(--color-muted);
}

.state-card {
  margin: 24rpx 0;
  padding: 40rpx 28rpx;
  text-align: center;
  color: var(--color-muted);
  background: var(--color-surface);
  border-radius: var(--radius-lg);
}

.state-title {
  margin-bottom: 10rpx;
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 650;
}

.primary-button,
.secondary-button {
  min-height: 88rpx;
  padding: 20rpx 30rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 48rpx;
}

.primary-button {
  color: #17130a;
  background: var(--color-accent);
}

.secondary-button {
  color: var(--color-text);
  background: var(--color-surface-soft);
}

.primary-button[disabled],
.secondary-button[disabled] {
  opacity: 0.48;
}

.focusable:focus {
  outline: 4rpx solid var(--color-accent);
  outline-offset: 4rpx;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}
