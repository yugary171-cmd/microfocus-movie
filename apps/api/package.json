{
  "name": "@microfocus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env ../../node_modules/tsx/dist/cli.mjs watch src/main.ts",
    "prebuild": "npm run build -w @microfocus/contracts",
    "build": "nest build",
    "pretypecheck": "npm run build -w @microfocus/contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node ../../scripts/run-with-root-env.mjs ../../node_modules/prisma/build/index.js generate",
    "db:migrate": "node ../../scripts/run-with-root-env.mjs ../../node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "node ../../scripts/run-with-root-env.mjs ../../node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node ../../scripts/run-with-root-env.mjs ../../node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "totp:reencrypt": "node ../../scripts/run-with-root-env.mjs ../../node_modules/tsx/dist/cli.mjs prisma/rotate-totp-encryption.ts"
  },
  "dependencies": {
    "@microfocus/contracts": "*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/node": "^22.17.2",
    "prisma": "^6.14.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
