generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  EDITOR
  REVIEWER
  ADMIN
}

enum DramaStatus {
  DRAFT
  UPLOADING
  PROCESSING
  PENDING_REVIEW
  PENDING_WECHAT
  READY
  PUBLISHED
  OFFLINE
  ARCHIVED
}

enum MediaStatus {
  CREATED
  UPLOADING
  PROCESSING
  REVIEW_REJECTED
  PENDING_MANUAL_REVIEW
  PENDING_WECHAT
  READY
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RightsStatus {
  DRAFT
  ACTIVE
  EXPIRED
  REVOKED
}

enum TranscodeStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ChallengeStatus {
  PENDING
  COMPLETED
  EXPIRED
  REJECTED
}

enum GrantSource {
  REWARDED_AD
  COMPENSATION
}

enum PlaybackLeaseStatus {
  ACTIVE
  REVOKED
  CLOSED
  EXPIRED
}

enum PlaybackReservationStatus {
  RESERVED
  CONFIRMED
  RELEASED
  UNCONFIRMED
}

enum CircuitState {
  CLOSED
  OPEN
}

enum EntitlementAdjustmentType {
  FREEZE_REMAINDER
  RELEASE_FREEZE
  WRITE_OFF
}

enum EntitlementFactType {
  GRANT
  DEBIT
  ADJUSTMENT
}

enum UserAccountStatus {
  ACTIVE
  DELETION_PENDING
}

enum DeletionRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

model User {
  id          String            @id @default(cuid())
  openId      String            @unique
  displayName String
  avatarUrl   String?
  status      UserAccountStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  challenges RewardChallenge[]
  grants      EntitlementGrant[]
  leases      PlaybackLease[]
  progress    WatchProgress[]
  deletionRequests DeletionRequest[]
}

model AnonymousViewerSession {
  id           String          @id @default(cuid())
  deviceId     String          @db.VarChar(128)
  sessionId    String          @db.VarChar(128)
  expiresAt    DateTime
  lastIssuedAt DateTime
  createdAt    DateTime        @default(now())
  leases       PlaybackLease[]

  @@unique([deviceId, sessionId])
  @@index([deviceId, createdAt])
}

model DeletionRequest {
  id              String                 @id @default(cuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id])
  status          DeletionRequestStatus  @default(PENDING)
  idempotencyKey  String                 @unique @db.VarChar(128)
  queryTokenHash  String                 @unique @db.VarChar(64)
  tokenExpiresAt  DateTime
  lastQueriedAt   DateTime?
  processedAt     DateTime?
  statusReason    String?                @db.VarChar(300)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([userId, status])
}

model AdminUser {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  role         AdminRole
  active       Boolean     @default(true)
  totpEnabled  Boolean     @default(false)
  totpSecretEncrypted String? @db.Text
  createdAt    DateTime    @default(now())
  editedDramas Drama[]     @relation("DramaEditor")
  reviews      DramaReview[]
  auditLogs    AuditLog[]
}

model Drama {
  id                 String        @id @default(cuid())
  title              String
  summary            String        @db.Text
  coverUrl           String
  category           String
  tagsJson           Json
  recommendationRank Int           @default(0)
  contentVersion     Int           @default(1)
  status             DramaStatus   @default(DRAFT)
  editorId           String
  editor             AdminUser     @relation("DramaEditor", fields: [editorId], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  publishedAt        DateTime?
  episodes           Episode[]
  rightsRecords       RightsRecord[]
  challenges         RewardChallenge[]
  grants             EntitlementGrant[]
  reviews            DramaReview[]
  progress           WatchProgress[]

  @@index([status, recommendationRank])
  @@index([category, status])
}

model RightsRecord {
  id                      String       @id @default(cuid())
  dramaId                 String
  drama                   Drama        @relation(fields: [dramaId], references: [id])
  version                 Int
  status                  RightsStatus @default(DRAFT)
  rightsHolder            String
  validFrom               DateTime
  validUntil              DateTime
  territory               String
  allowsWechatDistribution Boolean
  allowsAdMonetization    Boolean
  allowsTranscoding       Boolean
  allowsPromotionalMaterial Boolean
  licenseNumber           String
  reportNumber            String
  materialObjectKey       String
  materialDigestSha256    String
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@unique([dramaId, version])
  @@index([dramaId, status, validUntil])
}

model Episode {
  id                  String      @id @default(cuid())
  dramaId             String
  drama               Drama       @relation(fields: [dramaId], references: [id])
  episodeNumber       Int
  title               String
  durationSeconds     Int
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  mediaAssets         MediaAsset[]
  leases              PlaybackLease[]
  progress            WatchProgress[]

  @@unique([dramaId, episodeNumber])
  @@index([dramaId, episodeNumber])
}

model MediaAsset {
  id                  String          @id @default(cuid())
  episodeId           String
  episode             Episode         @relation(fields: [episodeId], references: [id])
  fileId              String          @unique
  version             Int
  isCurrent           Boolean         @default(false)
  mediaStatus         MediaStatus     @default(CREATED)
  transcodeStatus     TranscodeStatus @default(PENDING)
  machineReviewStatus ReviewStatus    @default(PENDING)
  manualReviewStatus  ReviewStatus    @default(PENDING)
  wechatReviewStatus  ReviewStatus    @default(PENDING)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([episodeId, version])
  @@index([episodeId, isCurrent])
}

model DramaReview {
  id         String       @id @default(cuid())
  dramaId    String
  drama      Drama        @relation(fields: [dramaId], references: [id])
  reviewerId String
  reviewer   AdminUser    @relation(fields: [reviewerId], references: [id])
  contentVersion Int
  status     ReviewStatus
  notes      String?      @db.Text
  createdAt  DateTime     @default(now())
}

model RewardChallenge {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  dramaId          String
  drama            Drama           @relation(fields: [dramaId], references: [id])
  sessionId        String
  nonceHash        String          @unique
  pendingKey       String?         @unique
  status           ChallengeStatus @default(PENDING)
  verificationMode String
  createdAt        DateTime        @default(now())
  expiresAt        DateTime
  completedAt      DateTime?
  verifiedAt       DateTime?
  completionKey    String?         @unique
  grant            EntitlementGrant?

  @@index([userId, createdAt])
}

model EntitlementGrant {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  dramaId          String
  drama            Drama           @relation(fields: [dramaId], references: [id])
  challengeId      String?         @unique
  challenge        RewardChallenge? @relation(fields: [challengeId], references: [id])
  source           GrantSource
  grantedSeconds   Int
  remainingSeconds Int
  grantedAt        DateTime        @default(now())
  expiresAt        DateTime
  note             String?
  compensationKey  String?         @unique @db.VarChar(128)
  debits           EntitlementDebit[]
  adjustments      EntitlementAdjustment[]

  @@index([userId, dramaId, expiresAt])
}

model PlaybackLease {
  id               String              @id @default(cuid())
  userId           String?
  user             User?               @relation(fields: [userId], references: [id])
  viewerSessionId  String?
  viewerSession    AnonymousViewerSession? @relation(fields: [viewerSessionId], references: [id])
  episodeId        String
  episode           Episode             @relation(fields: [episodeId], references: [id])
  deviceId         String
  status           PlaybackLeaseStatus @default(ACTIVE)
  activeKey        String?              @unique
  lastSeq          Int                 @default(0)
  lastMediaPosition Decimal             @default(0) @db.Decimal(12, 3)
  lastHeartbeatAt  DateTime
  tokenExpiresAt   DateTime
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  revokedAt        DateTime?
  closedAt         DateTime?
  heartbeats       PlaybackHeartbeat[]
  debits           EntitlementDebit[]
  reservations     PlaybackReservation[]

  @@index([userId, status])
  @@index([viewerSessionId, status])
}

model PlaybackReservation {
  id                    String                     @id @default(cuid())
  leaseId               String
  lease                 PlaybackLease              @relation(fields: [leaseId], references: [id])
  windowIndex           Int
  reservedSeconds       Int
  status                PlaybackReservationStatus  @default(RESERVED)
  expiresAt             DateTime
  confirmedHeartbeatId  String?                    @unique
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@unique([leaseId, windowIndex])
  @@index([leaseId, status])
}

model PlaybackRecoveryEvent {
  id        String   @id @default(cuid())
  userId    String
  deviceId  String   @db.VarChar(128)
  leaseId   String
  reason    String
  createdAt DateTime @default(now())

  @@index([userId, deviceId, createdAt])
}

model PlaybackHeartbeat {
  id                   String        @id @default(cuid())
  leaseId              String
  lease                PlaybackLease @relation(fields: [leaseId], references: [id])
  seq                  Int
  mediaPositionSeconds Decimal       @db.Decimal(12, 3)
  debitedSeconds       Int
  remainingSeconds     Int?
  mayContinue          Boolean
  reason               String?
  createdAt            DateTime      @default(now())
  debits               EntitlementDebit[]

  @@unique([leaseId, seq])
}

model EntitlementDebit {
  id           String              @id @default(cuid())
  grantId      String
  grant        EntitlementGrant    @relation(fields: [grantId], references: [id])
  leaseId      String
  lease        PlaybackLease       @relation(fields: [leaseId], references: [id])
  heartbeatId  String
  heartbeat    PlaybackHeartbeat   @relation(fields: [heartbeatId], references: [id])
  heartbeatSeq Int
  seconds      Int
  createdAt    DateTime            @default(now())

  @@unique([grantId, leaseId, heartbeatSeq])
  @@index([leaseId, heartbeatSeq])
}

model EntitlementAdjustment {
  id                 String                     @id @default(cuid())
  type               EntitlementAdjustmentType
  grantId            String
  grant              EntitlementGrant           @relation(fields: [grantId], references: [id])
  sourceFactType     EntitlementFactType
  sourceFactId       String
  freezeAdjustmentId String?
  freezeSource       EntitlementAdjustment?     @relation("FreezeReleases", fields: [freezeAdjustmentId], references: [id])
  freezeReleases     EntitlementAdjustment[]    @relation("FreezeReleases")
  seconds            Int
  reason             String                     @db.VarChar(300)
  approvalNote       String?                    @db.VarChar(300)
  operatorAdminId    String
  idempotencyKey     String                     @unique @db.VarChar(128)
  createdAt          DateTime                   @default(now())

  @@index([grantId, type, createdAt])
  @@index([freezeAdjustmentId])
}

model WatchProgress {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  dramaId              String
  drama                Drama    @relation(fields: [dramaId], references: [id])
  episodeId            String
  episode              Episode  @relation(fields: [episodeId], references: [id])
  mediaPositionSeconds Decimal  @db.Decimal(12, 3)
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())

  @@unique([userId, dramaId])
  @@index([userId, updatedAt])
}

model CallbackEvent {
  id          String   @id
  provider    String
  eventType   String
  receivedAt  DateTime @default(now())
  processingUntil DateTime?
  attempts    Int      @default(0)
  processedAt DateTime?
  outcome     String?
}

model AuditLog {
  id          String     @id @default(cuid())
  adminId     String
  admin       AdminUser  @relation(fields: [adminId], references: [id])
  action      String
  targetType  String
  targetId    String
  metadataJson Json?
  createdAt   DateTime   @default(now())

  @@index([createdAt])
}

model OperationalEvent {
  id           String   @id @default(cuid())
  eventType    String
  actorType    String?
  actorId      String?
  entityType   String?
  entityId     String?
  requestId    String?
  value        Int?
  metadataJson Json?
  occurredAt   DateTime @default(now())

  @@index([eventType, occurredAt])
  @@index([entityType, entityId])
}

model CircuitBreaker {
  provider  String       @id
  state     CircuitState @default(CLOSED)
  reason    String?
  openedAt  DateTime?
  updatedAt DateTime     @updatedAt
}
