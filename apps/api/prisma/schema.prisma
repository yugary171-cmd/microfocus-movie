generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  EDITOR
  REVIEWER
  ADMIN
}

enum AdminSetupPurpose {
  INVITE
  CREDENTIAL_RESET
}

enum DramaStatus {
  DRAFT
  UPLOADING
  PROCESSING
  PENDING_REVIEW
  PENDING_WECHAT
  READY
  PUBLISHED
  OFFLINE
  ARCHIVED
}

enum MediaStatus {
  CREATED
  UPLOADING
  PROCESSING
  REVIEW_REJECTED
  PENDING_MANUAL_REVIEW
  PENDING_WECHAT
  READY
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RightsStatus {
  DRAFT
  ACTIVE
  EXPIRED
  REVOKED
}

enum TranscodeStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ChallengeStatus {
  PENDING
  COMPLETED
  COMPLETED_LATE
  EXPIRED
  REJECTED
}

enum GrantSource {
  REWARDED_AD
  COMPENSATION
}

enum PlaybackLeaseStatus {
  ACTIVE
  REVOKED
  CLOSED
  EXPIRED
}

enum PlaybackReservationStatus {
  RESERVED
  CONFIRMED
  RELEASED
  UNCONFIRMED
}

enum CircuitState {
  CLOSED
  OPEN
}

enum CallbackEventStatus {
  RECEIVED
  PROCESSING
  RETRYABLE_FAILURE
  DEAD_LETTER
  PROCESSED
  REJECTED
}

enum EntitlementAdjustmentType {
  FREEZE_REMAINDER
  RELEASE_FREEZE
  WRITE_OFF
}

enum EntitlementFactType {
  GRANT
  DEBIT
  ADJUSTMENT
}

enum UserAccountStatus {
  ACTIVE
  DELETION_PENDING
}

enum DeletionRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

model User {
  id                       String            @id @default(cuid())
  openId                   String            @unique
  displayName              String
  avatarUrl                String?           @db.VarChar(2048)
  signature                String            @default("") @db.VarChar(100)
  gender                   String            @default("unset") @db.VarChar(16)
  status                   UserAccountStatus @default(ACTIVE)
  followerCount            Int               @default(0)
  followingCount           Int               @default(0)
  receivedCommentLikeCount Int               @default(0)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  challenges               RewardChallenge[]
  grants                   EntitlementGrant[]
  leases                   PlaybackLease[]
  progress                 WatchProgress[]
  episodeProgress          WatchEpisodeProgress[]
  deletionRequests         DeletionRequest[]
  following                UserFollow[]      @relation("UserFollowing")
  followers                UserFollow[]      @relation("UserFollowers")
  authoredComments         Comment[]         @relation("CommentAuthor")
  wallComments             Comment[]         @relation("CommentWall")
  commentReplyTargets      Comment[]         @relation("CommentReplyTo")
  commentLikes             CommentLike[]
  conversationsAsLow       DirectConversation[] @relation("ConversationLow")
  conversationsAsHigh      DirectConversation[] @relation("ConversationHigh")
  sentMessages             DirectMessage[]
  favorites                DramaFavorite[]
  likedDramas              DramaLike[]
}

model AnonymousViewerSession {
  id           String          @id @default(cuid())
  deviceId     String          @db.VarChar(128)
  sessionId    String          @db.VarChar(128)
  expiresAt    DateTime
  lastIssuedAt DateTime
  createdAt    DateTime        @default(now())
  leases       PlaybackLease[]

  @@unique([deviceId, sessionId])
  @@index([deviceId, createdAt])
}

model DeletionRequest {
  id              String                 @id @default(cuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id])
  status          DeletionRequestStatus  @default(PENDING)
  idempotencyKey  String                 @unique @db.VarChar(128)
  queryTokenHash  String                 @unique @db.VarChar(64)
  tokenExpiresAt  DateTime
  lastQueriedAt   DateTime?
  processedAt     DateTime?
  statusReason    String?                @db.VarChar(300)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  queryTokenReissues DeletionQueryTokenReissue[]

  @@index([userId, status])
}

model DeletionQueryTokenReissue {
  id                String          @id @default(cuid())
  deletionRequestId String
  deletionRequest   DeletionRequest @relation(fields: [deletionRequestId], references: [id])
  operatorAdminId   String
  reason            String          @db.VarChar(300)
  approvalNote      String          @db.VarChar(300)
  confirmedUserId   String          @db.VarChar(191)
  idempotencyKey    String          @unique @db.VarChar(128)
  createdAt         DateTime        @default(now())

  @@index([deletionRequestId, createdAt])
}

model AdminUser {
  id                  String      @id @default(cuid())
  email               String      @unique
  displayName         String
  passwordHash        String?
  role                AdminRole
  active              Boolean     @default(true)
  setupCompletedAt    DateTime?
  sessionVersion      Int         @default(1)
  lastLoginAt         DateTime?
  totpEnabled         Boolean     @default(false)
  totpSecretEncrypted String?     @db.Text
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  editedDramas        Drama[]     @relation("DramaEditor")
  reviews             DramaReview[]
  auditLogs           AuditLog[]
  setupTokens         AdminSetupToken[]

  @@index([role, active, setupCompletedAt])
}

model AdminSetupToken {
  id                  String            @id @default(cuid())
  adminUserId         String
  adminUser           AdminUser         @relation(fields: [adminUserId], references: [id])
  purpose             AdminSetupPurpose
  tokenDigest         String            @unique @db.VarChar(64)
  totpSecretEncrypted String            @db.Text
  expiresAt           DateTime
  usedAt              DateTime?
  createdByAdminId    String            @db.VarChar(191)
  createdAt           DateTime          @default(now())

  @@index([adminUserId, purpose, createdAt])
  @@index([createdByAdminId, createdAt])
  @@index([expiresAt])
}

model Drama {
  id                 String        @id @default(cuid())
  title              String
  summary            String        @db.Text
  coverUrl           String
  category           String
  tagsJson           Json
  recommendationRank Int           @default(0)
  contentVersion     Int           @default(1)
  status             DramaStatus   @default(DRAFT)
  editorId           String
  editor             AdminUser     @relation("DramaEditor", fields: [editorId], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  publishedAt        DateTime?
  episodes           Episode[]
  rightsRecords       RightsRecord[]
  challenges         RewardChallenge[]
  grants             EntitlementGrant[]
  reviews            DramaReview[]
  progress           WatchProgress[]
  episodeProgress    WatchEpisodeProgress[]
  comments           Comment[]
  favorites          DramaFavorite[]
  likes              DramaLike[]

  @@index([status, recommendationRank])
  @@index([category, status])
}

model RightsRecord {
  id                      String       @id @default(cuid())
  dramaId                 String
  drama                   Drama        @relation(fields: [dramaId], references: [id])
  version                 Int
  status                  RightsStatus @default(DRAFT)
  rightsHolder            String
  validFrom               DateTime
  validUntil              DateTime
  territory               String
  allowsWechatDistribution Boolean
  allowsAdMonetization    Boolean
  allowsTranscoding       Boolean
  allowsPromotionalMaterial Boolean
  licenseNumber           String
  reportNumber            String
  materialObjectKey       String
  materialDigestSha256    String
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@unique([dramaId, version])
  @@index([dramaId, status, validUntil])
}

model Episode {
  id                  String      @id @default(cuid())
  dramaId             String
  drama               Drama       @relation(fields: [dramaId], references: [id])
  episodeNumber       Int
  title               String
  durationSeconds     Int
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  mediaAssets         MediaAsset[]
  leases              PlaybackLease[]
  progress            WatchProgress[]
  episodeProgress     WatchEpisodeProgress[]
  comments            Comment[]

  @@unique([dramaId, episodeNumber])
  @@index([dramaId, episodeNumber])
}

model MediaAsset {
  id                  String          @id @default(cuid())
  episodeId           String
  episode             Episode         @relation(fields: [episodeId], references: [id])
  fileId              String          @unique
  version             Int
  isCurrent           Boolean         @default(false)
  mediaStatus         MediaStatus     @default(CREATED)
  transcodeStatus     TranscodeStatus @default(PENDING)
  machineReviewStatus ReviewStatus    @default(PENDING)
  manualReviewStatus  ReviewStatus    @default(PENDING)
  wechatReviewStatus  ReviewStatus    @default(PENDING)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([episodeId, version])
  @@index([episodeId, isCurrent])
}

model DramaReview {
  id         String       @id @default(cuid())
  dramaId    String
  drama      Drama        @relation(fields: [dramaId], references: [id])
  reviewerId String
  reviewer   AdminUser    @relation(fields: [reviewerId], references: [id])
  contentVersion Int
  status     ReviewStatus
  notes      String?      @db.Text
  createdAt  DateTime     @default(now())
}

model RewardChallenge {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  dramaId          String
  drama            Drama           @relation(fields: [dramaId], references: [id])
  sessionId        String
  nonceHash        String          @unique
  pendingKey       String?         @unique
  status           ChallengeStatus @default(PENDING)
  verificationMode String
  createdAt        DateTime        @default(now())
  expiresAt        DateTime
  completedAt      DateTime?
  verifiedAt       DateTime?
  completionKey    String?         @unique
  grant            EntitlementGrant?

  @@index([userId, createdAt])
}

model EntitlementGrant {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  dramaId          String
  drama            Drama           @relation(fields: [dramaId], references: [id])
  challengeId      String?         @unique
  challenge        RewardChallenge? @relation(fields: [challengeId], references: [id])
  source           GrantSource
  grantedSeconds   Int
  remainingSeconds Int
  grantedAt        DateTime        @default(now())
  expiresAt        DateTime
  note             String?
  compensationKey  String?         @unique @db.VarChar(128)
  debits           EntitlementDebit[]
  adjustments      EntitlementAdjustment[]

  @@index([userId, dramaId, expiresAt])
}

model PlaybackLease {
  id               String              @id @default(cuid())
  userId           String?
  user             User?               @relation(fields: [userId], references: [id])
  viewerSessionId  String?
  viewerSession    AnonymousViewerSession? @relation(fields: [viewerSessionId], references: [id])
  episodeId        String
  episode           Episode             @relation(fields: [episodeId], references: [id])
  deviceId         String
  status           PlaybackLeaseStatus @default(ACTIVE)
  activeKey        String?              @unique
  lastSeq          Int                 @default(0)
  lastMediaPosition Decimal             @default(0) @db.Decimal(12, 3)
  lastHeartbeatAt  DateTime
  tokenExpiresAt   DateTime
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  revokedAt        DateTime?
  closedAt         DateTime?
  heartbeats       PlaybackHeartbeat[]
  debits           EntitlementDebit[]
  reservations     PlaybackReservation[]

  @@index([userId, status])
  @@index([viewerSessionId, status])
}

model PlaybackReservation {
  id                    String                     @id @default(cuid())
  leaseId               String
  lease                 PlaybackLease              @relation(fields: [leaseId], references: [id])
  windowIndex           Int
  reservedSeconds       Int
  status                PlaybackReservationStatus  @default(RESERVED)
  expiresAt             DateTime
  confirmedHeartbeatId  String?                    @unique
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@unique([leaseId, windowIndex])
  @@index([leaseId, status])
}

model PlaybackRecoveryEvent {
  id        String   @id @default(cuid())
  userId    String
  deviceId  String   @db.VarChar(128)
  leaseId   String
  reason    String
  createdAt DateTime @default(now())

  @@index([userId, deviceId, createdAt])
}

model PlaybackHeartbeat {
  id                   String        @id @default(cuid())
  leaseId              String
  lease                PlaybackLease @relation(fields: [leaseId], references: [id])
  seq                  Int
  mediaPositionSeconds Decimal       @db.Decimal(12, 3)
  debitedSeconds       Int
  remainingSeconds     Int?
  mayContinue          Boolean
  reason               String?
  createdAt            DateTime      @default(now())
  debits               EntitlementDebit[]

  @@unique([leaseId, seq])
}

model EntitlementDebit {
  id           String              @id @default(cuid())
  grantId      String
  grant        EntitlementGrant    @relation(fields: [grantId], references: [id])
  leaseId      String
  lease        PlaybackLease       @relation(fields: [leaseId], references: [id])
  heartbeatId  String
  heartbeat    PlaybackHeartbeat   @relation(fields: [heartbeatId], references: [id])
  heartbeatSeq Int
  seconds      Int
  createdAt    DateTime            @default(now())

  @@unique([grantId, leaseId, heartbeatSeq])
  @@index([leaseId, heartbeatSeq])
}

model EntitlementAdjustment {
  id                 String                     @id @default(cuid())
  type               EntitlementAdjustmentType
  grantId            String
  grant              EntitlementGrant           @relation(fields: [grantId], references: [id])
  sourceFactType     EntitlementFactType
  sourceFactId       String
  freezeAdjustmentId String?
  freezeSource       EntitlementAdjustment?     @relation("FreezeReleases", fields: [freezeAdjustmentId], references: [id])
  freezeReleases     EntitlementAdjustment[]    @relation("FreezeReleases")
  seconds            Int
  reason             String                     @db.VarChar(300)
  approvalNote       String?                    @db.VarChar(300)
  operatorAdminId    String
  idempotencyKey     String                     @unique @db.VarChar(128)
  createdAt          DateTime                   @default(now())

  @@index([grantId, type, createdAt])
  @@index([freezeAdjustmentId])
}

model WatchProgress {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  dramaId              String
  drama                Drama    @relation(fields: [dramaId], references: [id])
  episodeId            String
  episode              Episode  @relation(fields: [episodeId], references: [id])
  mediaPositionSeconds Decimal  @db.Decimal(12, 3)
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())

  @@unique([userId, dramaId])
  @@index([userId, updatedAt])
}

model WatchEpisodeProgress {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])
  dramaId              String
  drama                Drama     @relation(fields: [dramaId], references: [id])
  episodeId            String
  episode              Episode   @relation(fields: [episodeId], references: [id])
  mediaPositionSeconds Decimal   @db.Decimal(12, 3)
  completedAt          DateTime?
  updatedAt            DateTime  @updatedAt
  createdAt            DateTime  @default(now())

  @@unique([userId, episodeId])
  @@index([userId, dramaId])
}

model UserFollow {
  id         String   @id @default(cuid())
  followerId String
  follower   User     @relation("UserFollowing", fields: [followerId], references: [id])
  followeeId String
  followee   User     @relation("UserFollowers", fields: [followeeId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([followerId, followeeId])
  @@index([followeeId, createdAt])
  @@index([followerId, createdAt])
}

model Comment {
  id              String    @id @default(cuid())
  targetType      String    @db.VarChar(16)
  dramaId         String?
  drama           Drama?    @relation(fields: [dramaId], references: [id])
  targetUserId    String?
  targetUser      User?     @relation("CommentWall", fields: [targetUserId], references: [id])
  episodeId       String?
  episode         Episode?  @relation(fields: [episodeId], references: [id])
  parentCommentId String?
  parent          Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         Comment[] @relation("CommentReplies")
  replyToUserId   String?
  replyToUser     User?     @relation("CommentReplyTo", fields: [replyToUserId], references: [id])
  authorUserId    String
  author          User      @relation("CommentAuthor", fields: [authorUserId], references: [id])
  body            String    @db.VarChar(500)
  likeCount       Int       @default(0)
  status          String    @db.VarChar(16)
  likes           CommentLike[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([targetType, dramaId, createdAt])
  @@index([targetType, targetUserId, createdAt])
  @@index([parentCommentId, createdAt])
  @@index([authorUserId, createdAt])
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId, createdAt])
}

model DirectConversation {
  id            String          @id @default(cuid())
  userLowId     String
  userLow       User            @relation("ConversationLow", fields: [userLowId], references: [id])
  userHighId    String
  userHigh      User            @relation("ConversationHigh", fields: [userHighId], references: [id])
  lastMessageAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  messages      DirectMessage[]

  @@unique([userLowId, userHighId])
  @@index([userLowId, lastMessageAt])
  @@index([userHighId, lastMessageAt])
}

model DirectMessage {
  id             String             @id @default(cuid())
  conversationId String
  conversation   DirectConversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User               @relation(fields: [senderId], references: [id])
  body           String             @db.VarChar(1000)
  createdAt      DateTime           @default(now())
  readAt         DateTime?

  @@index([conversationId, createdAt])
}

model DramaFavorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  dramaId   String
  drama     Drama    @relation(fields: [dramaId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, dramaId])
  @@index([userId, createdAt])
}

model DramaLike {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  dramaId   String
  drama     Drama    @relation(fields: [dramaId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, dramaId])
  @@index([userId, createdAt])
}

model CallbackEvent {
  id              String              @id
  provider        String
  eventType       String
  receivedAt      DateTime            @default(now())
  processingUntil DateTime?
  attempts        Int                 @default(0)
  processedAt     DateTime?
  outcome         String?
  status          CallbackEventStatus @default(RECEIVED)
  payloadHash     String?
  payloadCiphertext String? @db.Text
  payloadSchema     String? @db.VarChar(32)
  payloadRetainUntil DateTime?
  replays         CallbackReplay[]

  @@index([status, receivedAt])
}

model CallbackReplay {
  id              String        @id @default(cuid())
  eventId         String
  event           CallbackEvent @relation(fields: [eventId], references: [id])
  operatorAdminId String
  reason          String        @db.VarChar(300)
  approvalNote    String?       @db.VarChar(300)
  idempotencyKey  String        @unique @db.VarChar(128)
  createdAt       DateTime      @default(now())

  @@index([eventId, createdAt])
}

model AuditLog {
  id           String    @id @default(cuid())
  adminId      String
  admin        AdminUser @relation(fields: [adminId], references: [id])
  action       String
  targetType   String
  targetId     String
  requestId    String?   @db.VarChar(128)
  metadataJson Json?
  createdAt    DateTime  @default(now())

  @@index([createdAt])
  @@index([requestId])
}

model OperationalEvent {
  id           String   @id @default(cuid())
  eventType    String
  actorType    String?
  actorId      String?
  entityType   String?
  entityId     String?
  requestId    String?
  value        Int?
  metadataJson Json?
  occurredAt   DateTime @default(now())

  @@index([eventType, occurredAt])
  @@index([entityType, entityId])
}

model CircuitBreaker {
  provider  String       @id
  state     CircuitState @default(CLOSED)
  reason    String?
  openedAt  DateTime?
  updatedBy String?      @db.VarChar(128)
  updatedAt DateTime     @updatedAt
}

model BackgroundJobLease {
  jobName     String   @id @db.VarChar(64)
  ownerId     String   @db.VarChar(128)
  lockedUntil DateTime
  lastRunAt   DateTime?
  updatedAt   DateTime @updatedAt
}

model RateLimitBucket {
  id          String   @id @db.VarChar(128)
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}
