# Runtime
NODE_ENV=development
PORT=3000
PUBLIC_API_URL=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5174
# Optional. Mock demo videos are served by `npm run dev:admin`.
# Leave empty to auto-use this computer's LAN IPv4 so WeChat real-device debug can play them.
# Production playback never uses this; URLs come from the VOD lease over HTTPS.
DEMO_MEDIA_ORIGIN=
# Client packages. Unset / mock keeps internal Demo builds used by `npm run check`.
# External packages require MICROFOCUS_CLIENT_MODE=live and a public HTTPS API origin.
MICROFOCUS_CLIENT_MODE=mock
MICROFOCUS_PUBLIC_API_URL=
# Admin also reads VITE_API_BASE_URL; live mode prefers MICROFOCUS_PUBLIC_API_URL.
VITE_API_BASE_URL=
DATABASE_URL=mysql://microfocus:microfocus@localhost:3306/microfocus
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_BOOTSTRAP_EMAIL=admin@example.invalid
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
ADMIN_BOOTSTRAP_TOTP_SECRET=
ADMIN_TEST_OTP=123456
TOTP_ENCRYPTION_KEY=
# Full administrator lockout recovery is `npm run db:admin-break-glass`, not a login
# backdoor. Do not store ADMIN_BREAK_GLASS_* in the long-running API environment.
# See docs/admin-emergency-access.md.
# Optional. Previous TOTP encryption key during a dual-key rotation window only.
TOTP_ENCRYPTION_KEY_PREVIOUS=
# Optional. Encrypts callback payloads for audited replay. Falls back to TOTP_ENCRYPTION_KEY.
CALLBACK_PAYLOAD_ENCRYPTION_KEY=

# Release gate: production refuses to boot unless all release checks are true.
RELEASE_GATE_ENABLED=true
COMPLIANCE_ENTITY_APPROVED=false
COMPLIANCE_MINIPROGRAM_FILING=false
COMPLIANCE_WECHAT_CATEGORY=false
COMPLIANCE_ADS_APPROVED=false

# WeChat. Keep mock mode enabled until real credentials are configured.
WECHAT_MODE=mock
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REWARDED_AD_UNIT_ID=
WECHAT_REWARD_VERIFICATION=client_attestation
INTERNAL_CLIENT_ATTESTATION=true
WECHAT_CALLBACK_SECRET=

# Tencent Cloud VOD. Never expose these values to browsers or the mini program.
VOD_MODE=mock
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_VOD_SUB_APP_ID=
TENCENTCLOUD_VOD_PROCEDURE=
TENCENTCLOUD_VOD_CALLBACK_SECRET=
VOD_PLAYBACK_KEY=
VOD_MEDIA_HOST=media.example.com
