# Runtime
NODE_ENV=development
PORT=3000
PUBLIC_API_URL=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5173
DATABASE_URL=mysql://microfocus:microfocus@localhost:3306/microfocus
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_BOOTSTRAP_EMAIL=admin@example.invalid
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
ADMIN_BOOTSTRAP_TOTP_SECRET=
ADMIN_TEST_OTP=123456
TOTP_ENCRYPTION_KEY=

# Release gate: production refuses to boot unless all release checks are true.
RELEASE_GATE_ENABLED=true
COMPLIANCE_ENTITY_APPROVED=false
COMPLIANCE_MINIPROGRAM_FILING=false
COMPLIANCE_WECHAT_CATEGORY=false
COMPLIANCE_ADS_APPROVED=false

# WeChat. Keep mock mode enabled until real credentials are configured.
WECHAT_MODE=mock
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REWARDED_AD_UNIT_ID=
WECHAT_REWARD_VERIFICATION=client_attestation
INTERNAL_CLIENT_ATTESTATION=true
WECHAT_CALLBACK_SECRET=

# Tencent Cloud VOD. Never expose these values to browsers or the mini program.
VOD_MODE=mock
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_VOD_SUB_APP_ID=
TENCENTCLOUD_VOD_PROCEDURE=
TENCENTCLOUD_VOD_CALLBACK_SECRET=
VOD_PLAYBACK_KEY=
VOD_MEDIA_HOST=media.example.com
